# =============================================================================
# BrightBee Backend — Environment Variables
# Copy to .env and fill in values before running the server
# =============================================================================

# PostgreSQL connection string (must use asyncpg driver prefix)
DATABASE_URL=postgresql+asyncpg://tarun:12345@localhost:5432/brightbee

# JWT — generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password reset token TTL (minutes)
RESET_TOKEN_EXPIRE_MINUTES=15

# App
APP_ENV=development        # development | production
ALLOWED_ORIGINS=*          # comma-separated origins for CORS, e.g. http://localhost:3000
