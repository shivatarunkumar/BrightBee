# =============================================================================
# BrightBee — Database Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running setup.sh
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# PostgreSQL host (use "localhost" for local dev, or your cloud host)
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database name
DB_NAME=brightbee

# PostgreSQL superuser used ONLY during setup to create the DB and role
# (can be "postgres" or any role with CREATEDB + CREATEROLE privileges)
DB_ADMIN_USER=your_postgres_superuser
DB_ADMIN_PASSWORD=your_admin_password

# Application database user (created by setup.sh with limited privileges)
# For local dev you can reuse your superuser here
DB_APP_USER=your_app_user
DB_APP_PASSWORD=your_app_password

# Full connection string used by the Node.js backend (Prisma / pg)
# Must be a literal value — fill in DB_APP_USER, DB_APP_PASSWORD, DB_HOST, DB_PORT, DB_NAME manually
DATABASE_URL=postgresql://your_app_user:your_app_password@localhost:5432/brightbee
